{
  "name": "apc-syntax",
  "displayName": "APC (ASMPython C)",
  "description": "Syntax highlighting for APC (.apc) -- ASMPython's low-level systems language.",
  "version": "0.1.0",
  "publisher": "pixelateddream",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/deltathedumb/asmpython",
    "directory": "editors/vscode/apc-syntax"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "apc",
        "aliases": [
          "APC",
          "ASMPython C",
          "apc"
        ],
        "extensions": [
          ".apc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "apc",
        "scopeName": "source.apc",
        "path": "./syntaxes/apc.tmLanguage.json"
      }
    ]
  }
}
