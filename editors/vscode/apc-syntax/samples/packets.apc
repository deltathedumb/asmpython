# ══════════════════════════════════════════════════════════════════════════
#  packets.apc — build a wire packet, checksum it, verify it.
#
#  Compiles and runs:  asmpython build packets.apc --frontend apc -o packets
#  Exit code is the number of packets that failed verification (0 = all good).
# ══════════════════════════════════════════════════════════════════════════

extern func printf(fmt: string): i32
extern func malloc(n: u64): ptr
extern func free(p: ptr): none


# ── constants ─────────────────────────────────────────────────────────────
const POLY:  u32 = 0xEDB88320
const MAGIC: i64 = 0x504B


# ── the wire format ───────────────────────────────────────────────────────
# Offsets only where the format has a gap; the rest pack. The spec reserves
# byte 3, so `len` says where it starts and `crc` follows at 8.
layout Header {
    magic: bytes[2]
    flags: bytes[1]
    len:   bytes[4] = 4
    crc:   bytes[4]
}

# Explicit values because these bits cross the wire.
enum Flag[u8] {
    Compressed = 1
    Encrypted  = 2
    Signed     = 4
}

# Internal only — symbolic, no numbers, representation is the compiler's.
enum Status {
    OK,
    BadMagic,
    BadCrc,
}


# ── checksum ──────────────────────────────────────────────────────────────
func crc32(data: ptr, length: i64) {
    let crc = 0xFFFFFFFF as u32

    for (i = 0..length) {
        let acc = crc ^ (data[i] as u32)
        for (bit = 0..8) {
            if (acc & 1) {
                acc = (acc >> 1) ^ POLY
            } else {
                acc = acc >> 1
            }
        }
        crc = acc
    }
    ret crc ^ 0xFFFFFFFF
}: u32


# ── a verified packet ─────────────────────────────────────────────────────
type Packet {
    func constructor(body: ptr, length: i64, checksum: u32, status: i64) {
        pub const Parent.Body:     ptr = body
        pub const Parent.Length:   i64 = length
        pub const Parent.Checksum: u32 = checksum
        pub const Parent.Status:   i64 = status
    }: none

    func ok() {
        ret Parent.Status is Status::OK
    }: i64

    func plain describe(s: i64) {
        if (s is Status::OK)       { ret "ok" }
        if (s is Status::BadMagic) { ret "bad magic" }
        ret "bad crc"
    }: string
}


# ── framing ───────────────────────────────────────────────────────────────
# Writes a header plus `length` payload bytes into `buf`, returning total size.
func frame(buf: ptr, length: i64) {
    const h = buf as Header
    h.magic = MAGIC
    h.flags = Flag::Compressed
    h.len   = length

    const body = buf + 12
    for (i = 0..length) {
        body[i] = (i * 7 + 3) & 0xFF
    }

    h.crc = crc32(body, length)
    ret 12 + length
}: i64


func verify(buf: ptr) {
    const h = buf as Header

    if (!(h.magic as i64 is MAGIC)) {
        ret Status::BadMagic
    }

    const body = buf + 12
    const got  = crc32(body, h.len as i64)

    if (!(got is h.crc)) {
        ret Status::BadCrc
    }
    ret Status::OK
}: i64


# ── entry ─────────────────────────────────────────────────────────────────
func main() {
    let failures = 0

    for (n = 1..6) {
        const size = 12 + n * 8
        const buf  = malloc(size as u64)

        frame(buf, n * 8)
        const status = verify(buf)
        const p      = Packet(buf + 12, n * 8, 0, status)

        printf("packet %lld bytes: %s\n", n * 8, Packet::describe(status))

        if (!p::ok()) {
            failures = failures + 1
        }
        free(buf)
    }

    printf("%lld failed\n", failures)
    ret failures
}: i64
