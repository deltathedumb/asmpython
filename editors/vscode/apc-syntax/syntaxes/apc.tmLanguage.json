{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "APC",
  "scopeName": "source.apc",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#func-declaration" },
    { "include": "#type-declaration" },
    { "include": "#return-type" },
    { "include": "#type-annotation" },
    { "include": "#enum-member" },
    { "include": "#keywords" },
    { "include": "#builtin-types" },
    { "include": "#constants" },
    { "include": "#namespace" },
    { "include": "#function-call" },
    { "include": "#named-argument" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.apc",
          "match": "#.*$"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.apc",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "comment": "\\(0x00) -- escape holding an expression",
              "name": "constant.character.escape.apc",
              "match": "\\\\\\([^)]*\\)"
            },
            {
              "name": "constant.character.escape.apc",
              "match": "\\\\(?:[nrt0\\\\\"']|x[0-9a-fA-F]{2})"
            }
          ]
        }
      ]
    },

    "func-declaration": {
      "comment": "func name(...)  /  func plain name(...)  /  func constructor(...)",
      "match": "\\b(extern\\s+)?(func)\\s+(?:(plain)\\s+)?([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.modifier.extern.apc" },
        "2": { "name": "storage.type.function.apc" },
        "3": { "name": "storage.modifier.plain.apc" },
        "4": { "name": "entity.name.function.apc" }
      }
    },

    "type-declaration": {
      "comment": "type X { }   layout X { }   enum X[u8] { }",
      "match": "\\b(type|layout|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.apc" },
        "2": { "name": "entity.name.type.apc" }
      }
    },

    "return-type": {
      "comment": "trailing return type:  }: int",
      "match": "(\\})\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "punctuation.section.block.apc" },
        "2": { "name": "punctuation.separator.type.apc" },
        "3": {
          "patterns": [
            { "include": "#builtin-types" },
            { "match": ".+", "name": "entity.name.type.apc" }
          ]
        }
      }
    },

    "type-annotation": {
      "comment": "name: Type   and   name: bytes[4]",
      "match": "(?<!:)(:)(?!:)\\s*([A-Za-z_][A-Za-z0-9_]*)(\\[[^\\]]*\\])?",
      "captures": {
        "1": { "name": "punctuation.separator.type.apc" },
        "2": {
          "patterns": [
            { "include": "#builtin-types" },
            { "match": ".+", "name": "entity.name.type.apc" }
          ]
        },
        "3": {
          "patterns": [
            { "include": "#builtin-types" },
            { "include": "#constants" },
            { "include": "#punctuation" }
          ]
        }
      }
    },

    "enum-member": {
      "comment": "A line-leading CapitalizedName inside an enum body.",
      "match": "^\\s*([A-Z][A-Za-z0-9_]*)\\s*(?=[,=]|$)",
      "captures": {
        "1": { "name": "variable.other.enummember.apc" }
      }
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.apc",
          "match": "\\b(?:if|else|for|while|ret|break|continue)\\b"
        },
        {
          "name": "keyword.control.import.apc",
          "match": "\\b(?:import|export)\\b"
        },
        {
          "name": "storage.type.apc",
          "match": "\\b(?:func|type|layout|enum|const|let)\\b"
        },
        {
          "name": "storage.modifier.apc",
          "match": "\\b(?:pub|plain|extern)\\b"
        },
        {
          "name": "variable.language.this.apc",
          "match": "\\b(?:Parent|Self)\\b"
        },
        {
          "name": "entity.name.function.constructor.apc",
          "match": "\\bconstructor\\b"
        },
        {
          "name": "keyword.operator.word.apc",
          "match": "\\b(?:as|is|sizeof)\\b"
        }
      ]
    },

    "builtin-types": {
      "patterns": [
        {
          "name": "storage.type.primitive.apc",
          "match": "\\b(?:[iu][0-9]+|f32|f64|int|uint|float|bool|string|bytes|none|void|any|ptr)\\b"
        },
        {
          "name": "support.type.apc",
          "match": "\\b(?:Array|Console|Status)\\b"
        }
      ]
    },

    "constants": {
      "patterns": [
        {
          "name": "constant.numeric.hex.apc",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.apc",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.float.apc",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*\\b"
        },
        {
          "name": "constant.numeric.integer.apc",
          "match": "\\b[0-9][0-9_]*\\b"
        },
        {
          "name": "constant.language.apc",
          "match": "\\b(?:true|false|null|none)\\b"
        }
      ]
    },

    "namespace": {
      "comment": "std::(...), Console::Print, packets::element",
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(::)",
      "captures": {
        "1": { "name": "entity.name.namespace.apc" },
        "2": { "name": "punctuation.separator.namespace.apc" }
      }
    },

    "named-argument": {
      "comment": "call-site keyword argument:  strict=false",
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(=)(?!=)",
      "captures": {
        "1": { "name": "variable.parameter.apc" },
        "2": { "name": "keyword.operator.assignment.apc" }
      }
    },

    "function-call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.apc" }
      }
    },

    "operators": {
      "patterns": [
        { "name": "keyword.operator.range.apc", "match": "\\.\\." },
        { "name": "keyword.operator.comparison.apc", "match": "(?:==|!=|<=|>=|<|>)" },
        { "name": "keyword.operator.bitwise.apc", "match": "(?:<<|>>|&|\\||\\^|~)" },
        { "name": "keyword.operator.arithmetic.apc", "match": "(?:\\+|-|\\*|/|%)" },
        { "name": "keyword.operator.assignment.apc", "match": "=" },
        { "name": "keyword.operator.logical.apc", "match": "!" },
        { "name": "punctuation.accessor.apc", "match": "\\." }
      ]
    },

    "punctuation": {
      "patterns": [
        { "name": "punctuation.section.block.apc", "match": "[{}]" },
        { "name": "punctuation.section.brackets.apc", "match": "[\\[\\]]" },
        { "name": "punctuation.section.parens.apc", "match": "[()]" },
        { "name": "punctuation.separator.apc", "match": "[,;]" }
      ]
    }
  }
}
