# ── Editor / tooling ────────────────────────────────────────────────────────
/.claude/
/memory/
/.vscode/
/.idea/
/.asmpython-pytest-scout/
/agents/
*.swp

# ── Python bytecode / caches ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Build output ────────────────────────────────────────────────────────────
/build/
# Cached native runtime archives (regenerated on demand by _runtime/build.py).
_build/
# The per-test build directory the test runner writes into.
/tests/_build/
# Generated *_onedir bundles (executable + lib/ runtime).
*_onedir/

# ── Compiler / toolchain artifacts ──────────────────────────────────────────
# asmpython emits .asm next to the source and intermediate objects while
# linking; none of that belongs in the repo. (Hand-written package .asm under
# *.asmpkg/ is whitelisted below so packages stay tracked.)
*.asm
*.obj
*.o
*.exe
*.dll
*.so
*.a
*.lib

# Vendored SDL2 binaries (asmpython/_vendor/sdl2/README.md): these are
# intentionally committed so `import lumen` builds without any system SDL2
# install, so the binary-extension blanket ignores above don't apply here.
!asmpython/_vendor/**

# Keep the assembly sources that ship inside assembly packages.
!**/*.asmpkg/**/*.asm

# Keep the hand-written ABI shim layer bridging the new uasm-backed IR
# pipeline's standard-ABI calls to the legacy runtime's ad-hoc convention
# (see ir_lower.py's module docstring) -- this is source, not build output.
!asmpython/_runtime/abi_shims.asm
!asmpython/_runtime/abi_shims_linux.asm
!asmpython/_runtime/abi_shims_x86_32.asm
!asmpython/_runtime/threading_shims.asm

# ── Downloaded dependencies (NASM / GCC / embeddable Python) ─────────────────
/tools/
/local/

# ── Misc logs ───────────────────────────────────────────────────────────────
_smoke.log
*.log
*log*
!*/logging.*
nasm*.log
nasm*.txt

# `*log*` above is meant for log FILES, but it matches any path containing the
# three letters -- including test cases. `tests/cases/std_math_log_base.py` was
# written by its generator, run by the runner, and silently skipped by
# `git add`, which is how a probe can exist locally and never reach the repo.
# A corpus case is never a log file, so re-include them explicitly. (Only
# matters for files not already tracked; .gitignore does not affect those.)
!/tests/cases/*.py
!/tests/cases_fail/*.py
# AND A CHANGELOG, which is the same trap and cost the same way: the root
# `CHANGELOG.md` predates the rule and is tracked, so nothing looked wrong,
# while `archived/docs/CHANGELOG.md` -- 395 lines of it -- could not be added
# by any `git add` and reported nothing when one was tried.
!**/CHANGELOG.md

# Unit test artifacts
hi.txt
test.zip
_scratch*.*
_probe*.*
_tmp*.*

# CPython stdlib conformance fixtures (test.support.os_helper, tempfile, etc.)
# create these directly in the repo root's CWD when pyinbin runs the official
# Lib/test suite from here -- they're process-local scratch, not repo content.
/tmp*/
/Tmp*/
/@test_1_tmp*
/scratch_*.py
/full_conformance*.txt
/runner_out*.txt
/results.txt

# Local scratch directory for one-off manual testing (temp scripts, probe
# output, etc.) -- use this instead of littering the repo root.
/tmp/

# Zip for some reason
asmpython.zip

# VS Code specific files (one directory per extension under editors/vscode/)
editors/vscode/*/node_modules/
editors/vscode/*/out/
editors/vscode/**/*.vsix
editors/vscode/*/package-lock.json

/threads/

# The test runner's frozen copy of `src/`, one directory per run. It exists so
# `src/` can be edited while a run is in flight -- see tests/harness/snapshot.py
# -- and is removed when the run ends.
.harness-src/

# The test runner's record of what passed last time, keyed by a fingerprint of
# the sources. Local to one checkout -- see tests/harness/cache.py.
/.asmpython-tests.json

# Working conformance measurements. `asmpython.json` is the recorded state and
# is tracked; a session produces dozens of these on the way to it.
conformance/results/new*.json
# A work brief for a second agent, not part of the project.
port.txt
