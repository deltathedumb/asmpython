# ── Editor / tooling ────────────────────────────────────────────────────────
/.claude/
/memory/
/.vscode/
/.idea/
*.swp

# ── Python bytecode / caches ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Build output ────────────────────────────────────────────────────────────
/build/
# Cached native runtime archives (regenerated on demand by _runtime/build.py).
_build/
# The per-test build directory the test runner writes into.
/tests/_build/
# Generated *_onedir bundles (executable + lib/ runtime).
*_onedir/

# ── Compiler / toolchain artifacts ──────────────────────────────────────────
# asmpython emits .asm next to the source and intermediate objects while
# linking; none of that belongs in the repo. (Hand-written package .asm under
# *.asmpkg/ is whitelisted below so packages stay tracked.)
*.asm
*.obj
*.o
*.exe
*.dll
*.so
*.a
*.lib

# Keep the assembly sources that ship inside assembly packages.
!**/*.asmpkg/**/*.asm

# ── Downloaded dependencies (NASM / GCC / embeddable Python) ─────────────────
/tools/
/local/

# ── Misc logs ───────────────────────────────────────────────────────────────
_smoke.log
*.log
*log*
!*/logging.*
nasm*.log
nasm*.txt

# Unit test artifacts
hi.txt
test.zip
_scratch*.*
_probe*.*
_tmp*.*

# Zip for some reason
asmpython.zip

# VS Code specific files
editors/vscode/node_modules/
editors/vscode/out/
editors/vscode/*.vsix
editors/vscode/package-lock.json